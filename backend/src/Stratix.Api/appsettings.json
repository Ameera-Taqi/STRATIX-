{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Stratix": {
    "Jwt": {
      "Secret": "",
      "Issuer": "stratix",
      "Audience": "stratix-api",
      "ValidateIssuerAudience": false,
      "ExpirationMs": "900000"
    },
    "FrontendUrl": "http://localhost:4200",
    "Cors": {
      "Origins": "http://localhost:4200"
    },
    "AllowLoginAliases": false,
    "SyncSeedPasswords": false,
    "SeedData": true,
    "Storage": {
      "Root": "data",
      "MinFreeBytes": "52428800"
    },
    "BackgroundJobs": {
      "ReportOrphanCleanup": {
        "Enabled": true
      }
    },
    "PasswordReset": {
      "TokenPepper": "",
      "MaxPerHour": 3
    },
    "Mail": {
      "Host": "localhost",
      "Port": "1025",
      "From": "noreply@stratix.local",
      "SmtpAuth": false
    }
  }
}
