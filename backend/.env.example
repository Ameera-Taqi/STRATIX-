# Stratix .NET API — environment variables (copy to .env)

# SQL Server
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_DATABASE=StratixDB
MSSQL_PORT=1433

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Docker

# Database connection (used by docker-compose)
DB_CONNECTION=Server=sqlserver,1433;Database=StratixDB;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;Encrypt=False

# JWT
STRATIX_JWT_SECRET=change-this-secret-in-production-min-256-bits-long-enough

# Frontend / CORS
FRONTEND_URL=http://localhost:4200

# Seed data
STRATIX_SYNC_SEED_PASSWORDS=true
STRATIX_SEED_DATA=true

# Mail (Mailpit in Docker)
STRATIX_MAIL_HOST=mailpit
STRATIX_MAIL_PORT=1025
STRATIX_MAIL_FROM=noreply@stratix.local
