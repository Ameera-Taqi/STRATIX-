# Stratix environment variables
# Copy to .env: cp .env.example .env
# NEVER commit .env — secrets live only in local/CI secret stores.

# Microsoft SQL Server (Docker Compose)
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_DATABASE=StratixDB
MSSQL_PORT=1433

# ASP.NET Core 8 API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Docker

# REQUIRED — strong random secrets (>= 32 bytes). Generate e.g.:
#   openssl rand -base64 48
STRATIX_JWT_SECRET=change-this-secret-in-production-min-256-bits-long-enough
STRATIX_JWT_ISSUER=stratix
STRATIX_JWT_AUDIENCE=stratix-api
# Set true in Production (or leave ASPNETCORE_ENVIRONMENT=Production which enforces it)
STRATIX_JWT_VALIDATE_ISS_AUD=false
# Access token lifetime in ms (default 15 minutes). Refresh tokens remain 30 days.
STRATIX_JWT_EXPIRATION_MS=900000
STRATIX_RESET_PEPPER=change-this-reset-pepper-in-production-min-32-chars

# Login aliases (admin/sara/…) — keep false in production; true only for local DX
STRATIX_ALLOW_LOGIN_ALIASES=true

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=true
OPENAI_FALLBACK_ENABLED=true

# Frontend / CORS
FRONTEND_URL=http://localhost:4200

# Seed
STRATIX_SYNC_SEED_PASSWORDS=true
STRATIX_SEED_DATA=true

# Mail (Mailpit in Docker)
STRATIX_MAIL_HOST=mailpit
STRATIX_MAIL_PORT=1025
STRATIX_MAIL_FROM=noreply@stratix.local
