# Stratix environment variables
# Copy to .env: cp .env.example .env

# Microsoft SQL Server (Docker Compose)
# NOTE: change this password before any non-local deployment.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_DATABASE=StratixDB
MSSQL_PORT=1433

# ASP.NET Core 8 API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Docker
# REQUIRED in Production — a strong random secret (>= 32 bytes). The API refuses to start
# in Production with a weak/default value. Generate one, e.g.:  openssl rand -base64 48
STRATIX_JWT_SECRET=change-this-secret-in-production-min-256-bits-long-enough

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=true
OPENAI_FALLBACK_ENABLED=true
